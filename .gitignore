# Raw logs and datasets (contain IP addresses) - never commit
# data/.gitkeep is tracked so a fresh clone has data/ owned by the user (Docker would create it as root)
data/*
!data/.gitkeep
*.jsonl
*.pcap
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/

# LaTeX build
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.out
paper/*.synctex.gz
paper/*.pdf

# OS / editors
.DS_Store
.vscode/
.idea/
